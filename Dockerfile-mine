FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    nano \
    iputils-ping \
    python3-dev \
    libpq-dev \
    poppler-utils \
    tesseract-ocr \
    libreoffice \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "fastapi[all]" "uvicorn[standard]" \
    python-docx \
    python-pptx \
    pypdf \
    pandas \
    openpyxl \
    python-multipart \
    pdfminer.six \
    pytesseract \
    pdf2image \
    docx2txt \
    openai

# Copy the rest of the application
COPY . .

# Install the package in editable mode with server extras
RUN pip install -e ".[server]"

# Expose ports for the UI
EXPOSE 7777

# Create a playground file with health check
RUN echo 'from fastapi import FastAPI\nfrom phi.playground import Playground\nfrom phi.agent import Agent\nfrom phi.model.openai import OpenAIChat\n\n# Create base FastAPI app\napp = FastAPI()\n\n# Add health check endpoint\n@app.get("/health")\ndef health_check():\n    return {"status": "healthy"}\n\n# Create and setup agent playground\nagent = Agent(model=OpenAIChat())\nplayground = Playground(agents=[agent])\n\n# Include playground routes\napp.include_router(playground.get_router(), prefix="/v1")\n' > playground_app.py

# Command to run the playground with uvicorn
CMD ["uvicorn", "playground_app:app", "--host", "0.0.0.0", "--port", "7777"] 